# Copy to .env on the server and fill every value marked <...>. Never commit the real file.
APP_NAME="Event Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL from compose.yaml (bound to 127.0.0.1 only)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=eventmanagement
DB_USERNAME=eventmanagement
DB_PASSWORD=<password-kuat>
DB_ROOT_PASSWORD=<password-root-kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans SANDBOX keys (dashboard.sandbox.midtrans.com > Settings > Access Keys).
# Payment Notification URL there: https://<domain-anda>/webhooks/midtrans
MIDTRANS_SERVER_KEY=<SB-Mid-server-...>
MIDTRANS_CLIENT_KEY=<SB-Mid-client-...>
MIDTRANS_IS_PRODUCTION=false

BRAND_TAGLINE="Your Professional Ticketing Partner"
BRAND_WHATSAPP="+62 812-0000-0000"
BRAND_EMAIL="cs@<domain-anda>"

VITE_APP_NAME="${APP_NAME}"
